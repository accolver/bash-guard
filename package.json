{
  "name": "@accolver/bash-guard",
  "version": "0.1.1",
  "description": "Bash Guard pi extension with deterministic sensitive-command protection and LLM voting",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "bash-guard",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/accolver/bash-guard.git"
  },
  "homepage": "https://github.com/accolver/bash-guard",
  "scripts": {
    "check": "bun --check extensions/bash-guard/index.ts extensions/bash-guard/policy.ts extensions/bash-guard/config.ts",
    "test": "bun test extensions/bash-guard/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/bash-guard"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1"
  }
}
